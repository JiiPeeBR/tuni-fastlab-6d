VAR CONSTANT
	gMAX_SHUTTLE_COUNT : UINT := 35; (*Maximum numer of shuttles on the system*)
	gMAX_INDEX_SHUTTLE : UINT := gMAX_SHUTTLE_COUNT-1; (*Maximum index for a shuttles on the system*)
	gMAX_INDEX_PROGRAMS : UINT := 4; (*Maximum index for a shuttles on the system*)
END_VAR
(**)
(*6D Defaults*)
VAR CONSTANT
	gDEFAULT_Z : REAL := 0.0012;
END_VAR
(**)
(*6D Communication inteface*)
VAR
	gCommInput : Mc6DControllerFBIOType; (*Communication variable INPUT*)
	gCommOutput : Mc6DControllerFBIOType; (*Communication variable OUTPUT*)
END_VAR
(**)
(*Shuttles*)
VAR
	gShuttles : ShuttleListType;
END_VAR
(**)
(*PackML diagnostics*)
VAR
	gTasks : TaskDiagType;
END_VAR
(*Program list*)
VAR
	gPrograms : ARRAY[0..gMAX_INDEX_PROGRAMS] OF ProgramType; (*Add new program definitions to Main INIT section*)
END_VAR
