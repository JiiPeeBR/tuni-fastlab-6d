<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:iat="http://www.br-automation.com/iat2015/contentDefinition/v2" xmlns:types="http://www.br-automation.com/iat2015/widgetTypes/v2" elementFormDefault="qualified">
<xs:complexType name="widgets.MyWidgets.FileBrowserRestrict" abstract="true">
	<xs:complexContent>
		<xs:restriction base="iat:brease.core.BaseContentWidget">
			
			<xs:attribute name="tabIndex" use="optional" type="types:Integer" default="-1" />
			
			<xs:attribute name="height" use="optional" type="types:AutoSize" default="200" />
			
			<xs:attribute name="width" use="optional" type="types:AutoSize" default="300" />
			
		</xs:restriction>
	</xs:complexContent>
</xs:complexType>
<xs:complexType name="widgets.MyWidgets.FileBrowser">
	<xs:complexContent>
		<xs:extension base="iat:widgets.MyWidgets.FileBrowserRestrict">
			
			<xs:attribute name="allowFolderNavigation" use="optional" type="types:Boolean" default="true" />
			
			<xs:attribute name="confirmOverwrite" use="optional" type="types:Boolean" default="true" />
			
			<xs:attribute name="dialogFontSize" use="optional" type="types:Integer" default="16" />
			
			<xs:attribute name="dialogWidth" use="optional" type="types:Integer" default="320" />
			
			<xs:attribute name="fontSize" use="optional" type="types:Integer" default="12" />
			
			<xs:attribute name="imagePreview" use="optional" type="types:Boolean" default="true" />
			
			<xs:attribute name="maxFileSize" use="optional" type="types:Integer" default="10000000" />
			
			<xs:attribute name="overwriteCancelText" use="optional" type="types:String" default="Cancel" />
			
			<xs:attribute name="overwriteConfirmText" use="optional" type="types:String" default="Overwrite" />
			
			<xs:attribute name="overwritePrompt" use="optional" type="types:String" default="A file with this name already exists. Overwrite it?" />
			
			<xs:attribute name="path" use="optional" type="types:String" default="" />
			
			<xs:attribute name="rowHeight" use="optional" type="types:Integer" default="0" />
			
			<xs:attribute name="showDate" use="optional" type="types:Boolean" default="true" />
			
			<xs:attribute name="showSize" use="optional" type="types:Boolean" default="true" />
			
			<xs:attribute name="opacity" use="optional" type="types:Opacity" default="1" />
			
		</xs:extension>
	</xs:complexContent>
</xs:complexType>
</xs:schema>