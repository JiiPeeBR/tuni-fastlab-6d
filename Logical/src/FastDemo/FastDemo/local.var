VAR CONSTANT
	STATION_COUNT : DINT := 7;
END_VAR
(**)
VAR
	Task : REFERENCE TO FastDemoType;
	Local : FastDemoLocalType;
	Fb : FastDemoFbType;
	Hmi : FastDemoHmiType;
	StateCommands : FastDemoActionsStateType;
	SubStateCommands : FastDemoActionsSubstateType;
END_VAR
(* ----- PackML ----- *)
VAR
	em : EquipmentModule;
END_VAR
(*----- Stations ----*)
VAR
	station_num : {REDUND_UNREPLICABLE} DINT := 0;
	stations : ARRAY[0..STATION_COUNT] OF fdStation;
	pStation : REFERENCE TO fdStation;
	str : STRING[80];
	i : DINT;
END_VAR
