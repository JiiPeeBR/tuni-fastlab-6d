(*Constants*)
VAR CONSTANT
	STATION_COUNT : DINT := 7;
	LAST_INDEX_STATION_SHUTTLES : DINT := 3;
END_VAR
(**)
VAR
	Task : REFERENCE TO FastDemoType;
	Local : FastDemoLocalType;
	Fb : FastDemoFbType;
	StateCommands : FastDemoActionsStateType;
	SubStateCommands : FastDemoActionsSubstateType;
	str : STRING[80];
	i : DINT;
END_VAR
(* ----- PackML ----- *)
VAR
	Em : EquipmentModule;
END_VAR
(*----- Stations ----*)
VAR
	StationNumber : {REDUND_UNREPLICABLE} DINT := 0;
	Stations : ARRAY[0..STATION_COUNT] OF FastDemoStationType;
	pStation : REFERENCE TO FastDemoStationType;
END_VAR
